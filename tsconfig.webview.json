{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [],
    "noEmit": true
  },
  "include": ["src/webview/**/*.ts", "src/contract/**/*.ts", "src/review/**/*.ts", "src/protocol.ts"]
}
