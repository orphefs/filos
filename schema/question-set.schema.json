{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://filos.dev/schema/question-set-0.1.json",
  "title": "Filos question set (contract v0.1)",
  "description": "Mirrors src/contract/questions.ts. Kept to plain keywords (no $ref, no const) so it can go to a CLI's --json-schema as is; src/contract/validateQuestions.ts adds the rules a schema can't express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "depth", "questions"],
  "properties": {
    "contractVersion": {
      "enum": ["0.1"]
    },
    "depth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed", "why"],
      "properties": {
        "proposed": {
          "enum": ["skim", "standard", "deep"]
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nodeId", "stage", "purpose", "depth", "prompt"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "stage": {
            "enum": ["predict", "check"]
          },
          "purpose": {
            "enum": ["understand", "judge"]
          },
          "depth": {
            "enum": ["skim", "standard", "deep"]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "choices": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "explain"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "correct": {
                  "type": "boolean"
                },
                "explain": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                },
                "comment": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["body", "severity"],
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "severity": {
                      "enum": ["blocking", "suggestion", "question", "nit"]
                    }
                  }
                }
              }
            }
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
