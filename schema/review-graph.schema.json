{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://filos.dev/schema/review-graph-0.1.json",
  "title": "Filos review graph (contract v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "pr",
    "orientation",
    "nodes",
    "edges",
    "files"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1"
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "base",
        "head"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "orientation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "change",
          "risk",
          "summary",
          "anchors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "module",
              "file",
              "function",
              "class",
              "type",
              "external"
            ]
          },
          "parent": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "enum": [
              "added",
              "modified",
              "removed",
              "context"
            ]
          },
          "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signals",
              "why"
            ],
            "properties": {
              "signals": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "externalConsumers": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "internalFanOut": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "publicApi": {
                    "type": "boolean"
                  },
                  "hasTests": {
                    "type": "boolean"
                  },
                  "testsChanged": {
                    "type": "boolean"
                  },
                  "linesChanged": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "behaviourChange": {
                    "type": "boolean"
                  }
                }
              },
              "judgement": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "anchors": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/anchor"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "calls",
              "imports",
              "affects",
              "consumes",
              "tests"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "regions"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "startLine",
                "endLine",
                "gist"
              ],
              "properties": {
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "symbol": {
                  "$ref": "#/definitions/symbol"
                },
                "gist": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 140
                }
              }
            }
          }
        }
      }
    },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "startLine",
        "endLine"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "$ref": "#/definitions/symbol"
        }
      }
    },
    "symbol": {
      "description": "A declared name, e.g. Money.multiply. Display-only: hosts must escape it wherever they render it (the code pane puts it in an escaped markdown code span), so any characters are allowed.",
      "type": "string",
      "maxLength": 200
    }
  }
}
