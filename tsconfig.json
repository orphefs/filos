{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vscode", "mocha"],
    "noEmit": true
  },
  "include": ["src/extension.ts", "src/contract/**/*.ts", "src/agent/**/*.ts", "src/host/**/*.ts", "src/protocol.ts", "test/**/*.ts"]
}
