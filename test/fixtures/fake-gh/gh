#!/usr/bin/env node
// A stand-in for the GitHub CLI, for unit and e2e tests. It never talks to GitHub. See README.md.
'use strict';

const fs = require('node:fs');
const { execFileSync, spawnSync } = require('node:child_process');
const { pathToFileURL } = require('node:url');

const argv = process.argv.slice(2);
const env = process.env;

function modeNow() {
  const file = env.FAKE_GH_MODE_FILE;
  if (file) {
    try {
      const m = fs.readFileSync(file, 'utf8').trim();
      if (m) return m;
    } catch {
      // missing file: fall back to the environment
    }
  }
  return (env.FAKE_GH_MODE || 'ok').trim();
}

const mode = modeNow();
const repo = env.FAKE_GH_REPO || 'acme/ledger';
const host = env.FAKE_GH_HOST || 'github.com';
const number = Number(env.FAKE_GH_PR_NUMBER || 42);

function record(extra) {
  const file = env.FAKE_GH_RECORD;
  if (!file) return;
  // GH_HOST / GH_REPO as gh would see them: they redirect calls that don't name their host.
  fs.appendFileSync(file, JSON.stringify({ argv, cwd: process.cwd(), mode, ghHost: env.GH_HOST, ghRepo: env.GH_REPO, ...extra }) + '\n');
}

function out(obj) {
  process.stdout.write(JSON.stringify(obj) + '\n');
}

function fail(code, stderr, stdout) {
  if (stdout) process.stdout.write(stdout + '\n');
  process.stderr.write(stderr + '\n');
  process.exit(code);
}

function notLoggedIn() {
  fail(4, 'To get started with GitHub CLI, please run:  gh auth login\nAlternatively, populate the GH_TOKEN environment variable with a GitHub API authentication token.');
}

function headOid() {
  if (env.FAKE_GH_HEAD_OID) return env.FAKE_GH_HEAD_OID;
  try {
    return execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
  } catch {
    return '0'.repeat(40);
  }
}

function branch() {
  try {
    return execFileSync('git', ['rev-parse', '--abbrev-ref', 'HEAD'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
  } catch {
    return 'HEAD';
  }
}

/** Only the fields asked for with --json, as gh does. */
function pick(all) {
  const i = argv.indexOf('--json');
  const fields = i >= 0 && argv[i + 1] ? argv[i + 1].split(',') : Object.keys(all);
  return Object.fromEntries(fields.filter((f) => f in all).map((f) => [f, all[f]]));
}

function sleep(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

if (mode === 'slow') sleep(Number(env.FAKE_GH_DELAY_MS || 60000));

const [cmd, sub] = argv;

/** The value after --flag (or -f), if any. */
function flag(...names) {
  for (const n of names) {
    const i = argv.indexOf(n);
    if (i >= 0 && argv[i + 1] !== undefined) return argv[i + 1];
  }
  return undefined;
}

/** Pull requests from FAKE_GH_PR_JSON (one object or an array), or undefined when it isn't set. */
function prFixture() {
  const file = env.FAKE_GH_PR_JSON;
  if (!file) return undefined;
  const raw = JSON.parse(fs.readFileSync(file, 'utf8'));
  return Array.isArray(raw) ? raw : [raw];
}

/** `pr view <url | n | #n> [--repo owner/repo]`: the number asked for, and the repository named, if any. */
function viewSelector() {
  const sel = argv[2] && !argv[2].startsWith('-') ? argv[2] : undefined;
  if (!sel) return {};
  const url = /^https:\/\/([^/]+)\/([^/]+)\/([^/]+)\/pull\/(\d+)$/.exec(sel);
  if (url) return { number: Number(url[4]), repo: `${url[2]}/${url[3]}`, url: sel };
  const n = /^#?(\d+)$/.exec(sel);
  return n ? { number: Number(n[1]), repo: flag('--repo', '-R') } : { branch: sel };
}

function networkDown() {
  fail(1, `error connecting to ${host === 'github.com' ? 'api.github.com' : host}\ncheck your internet connection or https://githubstatus.com`);
}

function sso() {
  fail(1, 'GraphQL: Resource protected by organization SAML enforcement. You must grant your OAuth token access to this organization. (repository)');
}

if (cmd === '--version' || cmd === 'version') {
  process.stdout.write('gh version 0.0.0-fake (2026-10-03)\n');
  process.exit(0);
}

// --json fields are checked like gh does: unknown ones fail before anything else is asked. The default
// is gh 2.45's set (the oldest gh Filos supports; it has no baseRefOid), so a test that relies on a
// newer field fails unless it opts in with FAKE_GH_EXTRA_FIELDS. FAKE_GH_UNKNOWN_FIELDS removes fields.
const GH_245_PR_FIELDS = 'additions,assignees,author,autoMergeRequest,baseRefName,body,changedFiles,closed,closedAt,comments,commits,createdAt,deletions,files,headRefName,headRefOid,headRepository,headRepositoryOwner,id,isCrossRepository,isDraft,labels,latestReviews,maintainerCanModify,mergeCommit,mergeStateStatus,mergeable,mergedAt,mergedBy,milestone,number,potentialMergeCommit,projectCards,projectItems,reactionGroups,reviewDecision,reviewRequests,reviews,state,statusCheckRollup,title,updatedAt,url';
const GH_245_REPO_FIELDS = 'assignableUsers,codeOfConduct,contactLinks,createdAt,defaultBranchRef,deleteBranchOnMerge,description,diskUsage,forkCount,fundingLinks,hasDiscussionsEnabled,hasIssuesEnabled,hasProjectsEnabled,hasWikiEnabled,homepageUrl,id,isArchived,isBlankIssuesEnabled,isEmpty,isFork,isInOrganization,isMirror,isPrivate,isSecurityPolicyEnabled,isTemplate,isUserConfigurationRepository,issueTemplates,issues,labels,languages,latestRelease,licenseInfo,mentionableUsers,mergeCommitAllowed,milestones,mirrorUrl,name,nameWithOwner,openGraphImageUrl,owner,parent,primaryLanguage,projects,pullRequestTemplates,pullRequests,pushedAt,rebaseMergeAllowed,repositoryTopics,securityPolicyUrl,squashMergeAllowed,sshUrl,stargazerCount,templateRepository,updatedAt,url,usesCustomOpenGraphImage,viewerCanAdminister,viewerDefaultCommitEmail,viewerDefaultMergeMethod,viewerHasStarred,viewerPermission,viewerPossibleCommitEmails,viewerSubscription,visibility,watchers';
if (argv.includes('--json')) {
  const base = (cmd === 'repo' ? GH_245_REPO_FIELDS : GH_245_PR_FIELDS).split(',');
  const extra = (env.FAKE_GH_EXTRA_FIELDS || '').split(',').filter(Boolean);
  const removed = (env.FAKE_GH_UNKNOWN_FIELDS || '').split(',').filter(Boolean);
  const known = new Set([...base, ...extra].filter((f) => !removed.includes(f)));
  const asked = (argv[argv.indexOf('--json') + 1] || '').split(',').filter(Boolean);
  const bad = asked.find((f) => !known.has(f));
  if (bad) {
    record({});
    fail(1, `Unknown JSON field: "${bad}"\nAvailable fields:\n  ${[...known].sort().join('\n  ')}`);
  }
}

if (cmd === 'auth' && sub === 'status') {
  record({});
  if (mode === 'auth') fail(1, 'You are not logged into any GitHub hosts. To log in, run: gh auth login');
  process.stdout.write(`${host}\n  ✓ Logged in to ${host} account fake (keyring)\n`);
  process.exit(0);
}

if (cmd === 'pr' && sub === 'view' && prFixture()) {
  // Fixture mode: answers from FAKE_GH_PR_JSON for the pull request asked for (by URL, number or #n).
  record({});
  const sel = viewSelector();
  if (mode === 'auth') notLoggedIn();
  if (mode === 'network') networkDown();
  if (mode === 'sso') sso();
  if (mode === 'noremote' && !sel.url && !sel.repo) fail(1, 'none of the git remotes configured for this repository point to a known GitHub host. To tell gh about a new GitHub host, please use `gh auth login`');
  if (mode === 'noaccess') fail(1, `GraphQL: Could not resolve to a Repository with the name '${sel.repo || repo}'. (repository)`);
  const pr = mode === 'notfound' ? undefined : prFixture().find((p) => p.number === sel.number);
  if (!pr) fail(1, `GraphQL: Could not resolve to a PullRequest with the number of ${sel.number}. (repository.pullRequest)`);
  out(pick(pr));
  process.exit(0);
}

if (cmd === 'pr' && sub === 'list') {
  // The open pull requests of FAKE_GH_PR_LIST (a JSON array) or, failing that, FAKE_GH_PR_JSON.
  record({});
  if (mode === 'auth') notLoggedIn();
  if (mode === 'network') networkDown();
  if (mode === 'noremote') fail(1, 'none of the git remotes configured for this repository point to a known GitHub host. To tell gh about a new GitHub host, please use `gh auth login`');
  const list = env.FAKE_GH_PR_LIST ? JSON.parse(fs.readFileSync(env.FAKE_GH_PR_LIST, 'utf8')) : (prFixture() || []).filter((p) => (p.state || 'OPEN') === 'OPEN');
  const limit = Number(flag('--limit', '-L') || 30);
  out(list.slice(0, limit).map(pick));
  process.exit(0);
}

if (cmd === 'repo' && sub === 'clone') {
  // `repo clone [HOST/]OWNER/REPO <dir> [-- <git clone flags>]`: clones the LOCAL bare repo
  // FAKE_GH_REMOTE (over file://, so --filter works) into <dir>, passing the flags after "--" on to
  // git clone. Like gh, a name without a host means GH_HOST's (else github.com), and origin is that
  // host's https URL; an insteadOf in the clone sends fetches from there to the local repo.
  record({});
  if (mode === 'auth') notLoggedIn();
  if (mode === 'network') networkDown();
  const dd = argv.indexOf('--');
  const positional = (dd >= 0 ? argv.slice(2, dd) : argv.slice(2)).filter((a) => !a.startsWith('-'));
  const [name, dir] = positional;
  if (!name || !dir) fail(1, 'fake gh: repo clone needs <repo> <dir>');
  const parts = name.split('/');
  if (parts.length !== 2 && parts.length !== 3) fail(1, `fake gh: expected the "[HOST/]OWNER/REPO" format, got "${name}"`);
  const [cloneHost, owner, repoName] = parts.length === 3 ? parts : [env.GH_HOST || 'github.com', ...parts];
  if (mode === 'clonefail') fail(128, `Cloning into '${dir}'...\nremote: Repository not found.\nfatal: repository 'https://${cloneHost}/${owner}/${repoName}.git/' not found`);
  if (!env.FAKE_GH_REMOTE) fail(1, 'fake gh: FAKE_GH_REMOTE (a local bare repository) is not set');
  const extra = dd >= 0 ? argv.slice(dd + 1) : [];
  const local = pathToFileURL(env.FAKE_GH_REMOTE).href;
  const r = spawnSync('git', ['clone', '--quiet', ...extra, local, dir], { stdio: ['ignore', 'ignore', 'inherit'] });
  if (r.status !== 0) process.exit(r.status === null ? 1 : r.status);
  const origin = `https://${cloneHost}/${owner}/${repoName}.git`;
  const config = (k, v) => spawnSync('git', ['-C', dir, '-c', 'core.hooksPath=/dev/null', 'config', k, v], { stdio: ['ignore', 'ignore', 'inherit'] }).status;
  process.exit(config('remote.origin.url', origin) || config(`url.${local}.insteadOf`, origin) || 0);
}

if (cmd === 'pr' && sub === 'view') {
  record({});
  if (mode === 'auth') notLoggedIn();
  if (mode === 'nopr') fail(1, `no pull requests found for branch "${branch()}"`);
  if (mode === 'noremote') fail(1, 'none of the git remotes configured for this repository point to a known GitHub host. To tell gh about a new GitHub host, please use `gh auth login`');
  // `gh pr view <url>` answers for that PR (as gh does), whatever branch is checked out.
  const selected = argv[2] && !argv[2].startsWith('-') ? /^https:\/\/[^/]+\/[^/]+\/[^/]+\/pull\/(\d+)$/.exec(argv[2]) : null;
  const n = selected ? Number(selected[1]) : number;
  const url = selected ? argv[2] : env.FAKE_GH_PR_URL || `https://${host}/${repo}/pull/${n}`;
  out(pick({ number: n, url, headRefOid: headOid(), baseRefName: env.FAKE_GH_BASE || 'main', state: env.FAKE_GH_STATE || 'OPEN', headRefName: env.FAKE_GH_HEAD_REF || branch(), title: 'Fake pull request' }));
  process.exit(0);
}

if (cmd === 'repo' && sub === 'view') {
  record({});
  if (mode === 'auth') notLoggedIn();
  out(pick({ nameWithOwner: repo, url: `https://${host}/${repo}` }));
  process.exit(0);
}

if (cmd === 'api') {
  const input = argv.includes('--input') && argv[argv.indexOf('--input') + 1] === '-' ? fs.readFileSync(0, 'utf8') : undefined;
  record({ stdin: input });
  if (mode === 'auth') notLoggedIn();
  if (mode === 'api502') fail(1, 'gh: Bad Gateway (HTTP 502)', JSON.stringify({ message: 'Server Error' }));
  // The request was read (as if GitHub had it) before the answer stalls: gh is killed at the timeout.
  if (mode === 'apislow') sleep(Number(env.FAKE_GH_DELAY_MS || 60000));
  if (mode === 'apierror') {
    fail(
      1,
      'gh: Unprocessable Entity (HTTP 422)',
      JSON.stringify({ message: 'Unprocessable Entity', errors: ['Line could not be resolved'], documentation_url: 'https://docs.github.com/rest/pulls/reviews#create-a-review-for-a-pull-request', status: '422' }),
    );
  }
  const path = argv.find((a) => /^repos\//.test(a)) || '';
  const m = /^repos\/([^/]+)\/([^/]+)\/pulls\/(\d+)\/reviews$/.exec(path);
  if (!argv.includes('POST') || !m) fail(1, `gh: Not Found (HTTP 404)`, JSON.stringify({ message: 'Not Found' }));
  let payload;
  try {
    payload = JSON.parse(input || '');
  } catch {
    fail(1, 'gh: Problems parsing JSON (HTTP 400)', JSON.stringify({ message: 'Problems parsing JSON' }));
  }
  if (payload.event !== 'COMMENT' || typeof payload.body !== 'string' || !Array.isArray(payload.comments)) {
    fail(1, 'gh: Unprocessable Entity (HTTP 422)', JSON.stringify({ message: 'Unprocessable Entity', errors: ['bad review payload'] }));
  }
  const id = 1001;
  out({ id, html_url: `https://${host}/${m[1]}/${m[2]}/pull/${m[3]}#pullrequestreview-${id}`, state: 'COMMENTED', body: payload.body, commit_id: payload.commit_id });
  process.exit(0);
}

record({});
fail(2, `fake gh: unsupported command: ${argv.join(' ')}`);
